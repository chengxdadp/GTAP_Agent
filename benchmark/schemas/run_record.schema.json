{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gtap-agent-benchmark/run_record.schema.json",
  "title": "Immutable benchmark run record",
  "type": "object",
  "required": [
    "run_id",
    "case_id",
    "condition",
    "repetition",
    "provider",
    "model",
    "model_parameters",
    "started_at",
    "ended_at",
    "prompt_sha256",
    "system_prompt_sha256",
    "code_commit",
    "raw_response_path"
  ],
  "properties": {
    "run_id": {"type": "string"},
    "case_id": {"type": "string"},
    "condition": {"enum": ["agent_tools", "no_tools", "documentation_only"]},
    "repetition": {"type": "integer", "minimum": 1},
    "provider": {"type": "string"},
    "model": {"type": "string"},
    "model_parameters": {"type": "object"},
    "started_at": {"type": "string"},
    "ended_at": {"type": "string"},
    "prompt_sha256": {"type": "string"},
    "system_prompt_sha256": {"type": "string"},
    "code_commit": {"type": ["string", "null"]},
    "raw_response_path": {"type": "string"},
    "tool_trace_path": {"type": ["string", "null"]},
    "artifact_dir": {"type": ["string", "null"]},
    "prediction_path": {"type": ["string", "null"]},
    "latency_seconds": {"type": ["number", "null"]},
    "input_tokens": {"type": ["integer", "null"]},
    "output_tokens": {"type": ["integer", "null"]},
    "api_cost": {"type": ["number", "null"]}
  },
  "additionalProperties": false
}
